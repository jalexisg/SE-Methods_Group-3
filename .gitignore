# Build output
target/

# IntelliJ IDEA user-specific files
.idea/workspace.xml
.idea/shelf/

# Compiled class files
*.class

# Logs
*.log

# Package files
*.jar
*.war
*.zip

# Maven wrapper and local build files
.mvn/
dependency-reduced-pom.xml
release.properties

# Ignore VSCode workspace files (keep local only)
.vscode/

# Generated reports (avoid noisy git status)
tmp/reports/

# macOS
.DS_Store

# Do not track the generated reports index (it is regenerated at runtime)
/reports/index.html

# Do not track generated Markdown reports
/reports/*.md